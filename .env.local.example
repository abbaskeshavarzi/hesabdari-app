# Supabase project settings
# Copy this file to .env.local and fill the values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: set when deploying to GitHub Pages under a repository path.
# GITHUB_PAGES=true
# REPO_NAME=hesabdari-app
