{
  "name": "hesabdari-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build",
    "test": "npm run test:unit",
    "lint": "node scripts/lint.mjs",
    "typecheck": "npx --yes -p typescript@5.9.2 tsc --noEmit --allowJs --checkJs false --jsx preserve --moduleResolution bundler --module esnext --target ES2020 --skipLibCheck pages/*.js components/*.js lib/*.js",
    "build:verify": "npm run build && test -d out",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:smoke": "node --test tests/build-smoke.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "chart.js": "^4.4.4",
    "jspdf": "^2.5.2",
    "modern-screenshot": "^4.5.4",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7"
  }
}
